{
  "name": "presslab-global-radar",
  "version": "0.1.0",
  "description": "World Press Monitor: open-source RSS atlas and feed validation pipeline for global news sources.",
  "license": "MIT",
  "homepage": "https://github.com/mylee04/world-press-monitor",
  "repository": {
    "type": "git",
    "url": "https://github.com/mylee04/world-press-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/mylee04/world-press-monitor/issues"
  },
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify:readme-rss": "bun scripts/verify-readme-rss.ts",
    "verify:readme-rss:precheck": "bun scripts/verify-readme-rss.ts --precheck",
    "rss:health:backlog": "bun scripts/make-rss-fix-backlog.ts",
    "rss:health:once": "bun scripts/rss-health-daily.ts",
    "rss:health:daily": "bun scripts/rss-health-daily.ts",
    "rss:health:cron:run": "bash scripts/run-rss-health-daily.sh",
    "rss:health:cron:setup": "bash scripts/setup-rss-health-cron.sh install",
    "rss:health:cron:remove": "bash scripts/setup-rss-health-cron.sh uninstall",
    "rss:health:cron:print": "bash scripts/setup-rss-health-cron.sh print",
    "rss:migrate-official": "bun scripts/migrate-proxy-rss-to-official.ts",
    "api:news:incremental": "bash scripts/run-fetch-news-api-incremental.sh",
    "api:news:serve": "bash scripts/run-api-news.sh",
    "api:news:fetch": "bash scripts/fetch-news-api.sh",
    "atlas:export": "bun scripts/export-rss-atlas.ts",
    "atlas:export-catalog": "bun scripts/export-rss-catalog.ts",
    "ingest:once": "bun scripts/ingest-worker.ts --once",
    "ingest:loop": "bun scripts/ingest-worker.ts",
    "ingest:ops:hourly": "bun scripts/ingest-ops-report.ts --hours=1 --write-json",
    "ingest:ops:daily": "bun scripts/ingest-ops-report.ts --mode=daily --days=1 --write-json",
    "ingest:cron:run": "bash scripts/run-ingest-hourly.sh",
    "ingest:cron:setup": "bash scripts/setup-ingest-cron.sh install",
    "ingest:cron:remove": "bash scripts/setup-ingest-cron.sh uninstall",
    "ingest:cron:print": "bash scripts/setup-ingest-cron.sh print",
    "ingest:ops:cron:run:hourly": "bash scripts/run-ingest-ops-hourly.sh",
    "ingest:ops:cron:run:daily": "bash scripts/run-ingest-ops-daily.sh",
    "ingest:ops:cron:setup": "bash scripts/setup-ingest-ops-cron.sh install",
    "ingest:ops:cron:remove": "bash scripts/setup-ingest-ops-cron.sh uninstall",
    "ingest:ops:cron:print": "bash scripts/setup-ingest-ops-cron.sh print",
    "news:country:discord": "bun scripts/report-news-by-country-discord.ts",
    "news:country:discord:cron:run": "bash scripts/run-news-country-discord-report.sh",
    "news:country:discord:cron:setup": "bash scripts/setup-news-country-discord-cron.sh install",
    "news:country:discord:cron:remove": "bash scripts/setup-news-country-discord-cron.sh uninstall",
    "news:country:discord:cron:print": "bash scripts/setup-news-country-discord-cron.sh print",
    "db:init": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:bootstrap-wpm": "bash scripts/bootstrap-wpm-db.sh",
    "db:check-schema-sync": "bun scripts/check-db-schema-sync.ts",
    "db:studio": "bash scripts/db-studio.sh",
    "db:introspect": "bash scripts/db-introspect.sh",
    "db:cleanup-legacy-tables": "bun scripts/purge-legacy-db-tables.ts",
    "db:cleanup-legacy-tables:all": "bun scripts/purge-legacy-db-tables.ts --all",
    "db:cleanup-legacy-tables:apply": "bun scripts/purge-legacy-db-tables.ts --apply",
    "db:cleanup-legacy-tables:apply:all": "bun scripts/purge-legacy-db-tables.ts --all --apply",
    "stats:news:by-country": "bash scripts/stats-news-by-country.sh"
  },
  "dependencies": {
    "@upstash/redis": "^1.35.6",
    "drizzle-orm": "^0.45.1",
    "maplibre-gl": "^4.7.1",
    "next": "15.1.7",
    "pg": "^8.16.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.31.9",
    "playwright": "^1.58.2",
    "typescript": "^5.7.3"
  }
}
