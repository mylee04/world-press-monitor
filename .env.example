# Optional: async beat refinement
GROQ_API_KEY=gsk_xxx

# Optional: cross-user cache for classification
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Optional: local PostgreSQL for Writing/Distribution draft persistence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/presslab

# Radar service API auth (for external consumers like listening dashboard)
RADAR_SERVICE_API_KEY=change_me_to_long_random_key
# Optional key rotation list (comma-separated)
RADAR_SERVICE_API_KEYS=
