# Optional: async beat refinement
GROQ_API_KEY=gsk_xxx

# Optional: cross-user cache for classification
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Optional: local PostgreSQL for Writing/Distribution draft persistence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/presslab

# Radar service API auth (scoped keys only; for external consumers like listening dashboard)
RADAR_SERVICE_API_KEYS=
# Example scoped keys:
# RADAR_SERVICE_API_KEYS=ops_only_token:read:ops,listening_token:read:articles|read:sources|read:ops
# Recommended (split tokens by consumer):
# RADAR_SERVICE_API_KEYS=personal_ops_token:read:ops,listening_dashboard_token:read:articles|read:sources
# Optional writer token:
# RADAR_SERVICE_API_KEYS=personal_ops_token:read:ops,listening_dashboard_token:read:articles|read:sources,worker_ingest_token:write:ingest
RADAR_SERVICE_RATE_LIMIT_RPM=240
RADAR_SERVICE_REQUIRE_AUTH=true

# Radar cron auth
CRON_SECRET=
RADAR_CRON_TOKEN=

# Radar summary pipeline (GLM)
GLM_API_KEY=
RADAR_GLM_MODEL=glm-4.7-flash
RADAR_GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RADAR_SUMMARY_BATCH_SIZE=10
RADAR_SUMMARY_MAX_ATTEMPTS=4
RADAR_SUMMARY_TIMEOUT_MS=12000
RADAR_SUMMARY_MAX_CONTEXT_CHARS=3500
RADAR_SUMMARY_MAX_SUMMARY_CHARS=900
RADAR_SUMMARY_DAILY_GLM_LIMIT=15000
RADAR_SUMMARY_RATE_LIMIT_COOLDOWN_MINUTES=1

# Radar Discord notifications
RADAR_OPS_DISCORD_WEBHOOK=
RADAR_HOURLY_DISCORD_WEBHOOK=

# Writing: breaking-only full-text drafting (no storage)
WRITING_FULLTEXT_ENABLED=false
WRITING_FULLTEXT_ALLOWED_DOMAINS=
WRITING_FULLTEXT_TIMEOUT_MS=15000
WRITING_FULLTEXT_MAX_CHARS=12000
WRITING_FULLTEXT_MAX_SCRAPE_SOURCES=2
WRITING_GLM_MODEL=
