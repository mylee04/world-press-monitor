<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wpm.ingest-hourly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/your-user/srv/world-press-monitor/repo &amp;&amp; bash scripts/run-ingest-hourly-local.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/your-user/srv/world-press-monitor/repo</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>25</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/your-user/srv/world-press-monitor/logs/launchd-ingest-hourly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/your-user/srv/world-press-monitor/logs/launchd-ingest-hourly.log</string>
</dict>
</plist>
