<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wpr.api-runtime-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>bash /Users/your-user/srv/world-press-radar/repo/scripts/ensure-api-runtime-local.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/your-user/srv/world-press-radar/repo</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/Users/your-user/srv/world-press-radar/logs/launchd-api-runtime-watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/your-user/srv/world-press-radar/logs/launchd-api-runtime-watchdog.log</string>
</dict>
</plist>
