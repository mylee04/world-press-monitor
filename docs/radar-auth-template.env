# Radar API auth template (copy values into .env.local)
# Use long random tokens. Do not commit real tokens.

# Keep this true in any shared environment.
RADAR_SERVICE_REQUIRE_AUTH=true
RADAR_SERVICE_RATE_LIMIT_RPM=240

# Scoped keys only.
# Format: token:scope1|scope2,token2:scope
#
# Recommended split:
# - personal_ops_token: only for your private ops dashboards/metrics
# - listening_dashboard_token: read-only for article/source endpoints
# - optional writer token: only for ingest trigger endpoints
RADAR_SERVICE_API_KEYS=personal_ops_token:read:ops,listening_dashboard_token:read:articles|read:sources,worker_ingest_token:write:ingest

# Example curl usage:
# curl -H "Authorization: Bearer personal_ops_token" "http://127.0.0.1:3000/api/radar/v1/ops/summary"
# curl -H "Authorization: Bearer listening_dashboard_token" "http://127.0.0.1:3000/api/radar/v1/articles?hours=24&limit=20"
